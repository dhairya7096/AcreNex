<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/acrenex_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/acrenex_navy" app:cardCornerRadius="26dp"
            app:strokeColor="@color/acrenex_green" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <ImageView android:layout_width="68dp" android:layout_height="68dp" android:padding="5dp" android:background="@drawable/bg_white_round" android:src="@drawable/ic_acrenex_mark" android:contentDescription="AcreNex company mark"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="ACCOUNT RECOVERY" android:textColor="@color/acrenex_gold" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Reset your AcreNex password" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvResetStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#D7E7E0" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="24dp" app:strokeColor="@color/acrenex_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Account verification" android:textColor="@color/acrenex_text" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Only an existing account can reset its password. Officer roles are never created through recovery." android:textColor="@color/acrenex_secondary_text" android:textSize="11sp"/>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/resetIdentifierLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Registered email or mobile" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:boxStrokeColor="@color/acrenex_blue">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etResetIdentifier" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:id="@+id/otpBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="6-digit OTP">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etResetOtp" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="6"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:id="@+id/tvDemoOtp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:background="#FFF4CF" android:textColor="#6B5315" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/passwordBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="New password" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etResetNewPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Confirm new password" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etResetConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnResetPrimary" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="17dp" android:text="Send OTP" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold" app:backgroundTint="@color/acrenex_blue" app:cornerRadius="15dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/tvBackToLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="← Back to secure login" android:textColor="@color/acrenex_blue" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
