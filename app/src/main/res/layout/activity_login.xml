<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F1"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0B3B2E"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="#2D795D"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <ImageView
                    android:id="@+id/ivLoginLogo"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:background="#FFFFFF"
                    android:contentDescription="AcreNex company mark"
                    android:padding="6dp"
                    android:src="@drawable/ic_acrenex_mark" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACRENEX" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="LAND INTELLIGENCE PLATFORM" android:textColor="#E7C65B" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Secure access to your parcel, records and services." android:textColor="#D7E7E0" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:text="WELCOME BACK"
            android:textColor="#2F8F45"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:text="Sign in to your land workspace"
            android:textColor="#17372D"
            android:textSize="29sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="5dp"
            android:text="One account. One password. Role permissions stay linked to the account record."
            android:textColor="#6E7E77"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="2dp"
            app:strokeColor="#DCE4DF"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SECURE ACCESS" android:textColor="#6E7E77" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#EEF4EF" android:orientation="horizontal" android:padding="12dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="✓" android:textColor="#2F8F45" android:textStyle="bold" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Your account role is read from the authorized account record. Officer accounts cannot be created from this login screen." android:textColor="#315A48" android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="Email address"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#2F8F45">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLines="1" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Password"
                    app:endIconMode="password_toggle"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#2F8F45">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:id="@+id/tvForgotPassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="7dp" android:text="Forgot password?" android:textColor="#176B5A" android:textSize="10sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="13dp" android:text="Continue securely  →" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="#176B5A" app:cornerRadius="15dp" />
                <TextView android:id="@+id/tvOfficerRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Officer / Department user?  Create officer access" android:textColor="#0B3B2E" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="New citizen?  Create an account" android:textColor="#176B5A" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#EAF5EE" android:gravity="center_vertical" android:orientation="horizontal" android:padding="13dp">
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="✓" android:textColor="#2F8F45" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Your local prototype data is kept parcel-centric. Production integrations should use authorized departmental systems." android:textColor="#315A48" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
