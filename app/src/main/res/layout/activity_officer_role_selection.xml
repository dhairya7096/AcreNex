<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F6F1">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_acrenex_mark" android:contentDescription="AcreNex" android:layout_marginBottom="14dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Department Workspaces" android:textSize="28sp" android:textStyle="bold" android:textColor="#17372D"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a role to preview its dedicated Land Stack command centre." android:textSize="14sp" android:textColor="#6E7E77" android:layout_marginTop="6dp" android:layout_marginBottom="20dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnRevenue" android:layout_width="match_parent" android:layout_height="52dp" android:text="Revenue Officer" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnRegistration" android:layout_width="match_parent" android:layout_height="52dp" android:text="Registration Officer" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSurveyGIS" android:layout_width="match_parent" android:layout_height="52dp" android:text="Survey / GIS Officer" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnPlanning" android:layout_width="match_parent" android:layout_height="52dp" android:text="Municipal / Planning Officer" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnTax" android:layout_width="match_parent" android:layout_height="52dp" android:text="Property Tax Officer" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnDispute" android:layout_width="match_parent" android:layout_height="52dp" android:text="Dispute / Case Officer" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnEnvironment" android:layout_width="match_parent" android:layout_height="52dp" android:text="Environment / Restriction Officer" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnAdmin" android:layout_width="match_parent" android:layout_height="52dp" android:text="Super Admin / Command Centre" android:textAllCaps="false" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="10dp" app:cornerRadius="14dp" android:backgroundTint="#176B5A"/>
</LinearLayout></ScrollView>
